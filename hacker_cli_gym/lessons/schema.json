{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikegropp/hacker-cli-gym/blob/main/hacker_cli_gym/lessons/schema.json",
  "title": "Hacker CLI Gym curriculum catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "track", "platforms", "shell", "lessons"],
  "properties": {
    "catalog_version": {"const": 1},
    "track": {"enum": ["linux", "powershell"]},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["linux", "windows"]}
    },
    "shell": {"enum": ["posix", "powershell"]},
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/lesson"}
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "section",
        "command",
        "title",
        "about",
        "example",
        "example_output",
        "breakdown",
        "task",
        "solution",
        "files",
        "allowed",
        "checks",
        "completion"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(linux|powershell)-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "section": {"type": "string", "pattern": "^(0[1-9]|10)-[a-z]+(?:-[a-z]+)*$"},
        "command": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 3},
        "about": {"type": "string", "minLength": 20},
        "difficulty": {"enum": ["foundation", "intermediate", "advanced"]},
        "example": {"type": "string", "minLength": 1},
        "example_output": {"type": "string"},
        "breakdown": {"$ref": "#/$defs/nonEmptyStrings"},
        "task": {"type": "string", "minLength": 10},
        "hints": {"$ref": "#/$defs/nonEmptyStrings"},
        "solution": {"type": "string", "minLength": 1},
        "directories": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "files": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["&&", ";"]}
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "completion": {"type": "string", "minLength": 10}
      }
    },
    "check": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {
          "enum": [
            "stdout",
            "stdout-unordered-lines",
            "stdout-contains",
            "output-contains",
            "stderr-contains",
            "stdout-nonempty",
            "stdout-regex",
            "path-exists",
            "path-not-exists",
            "file-content",
            "file-mode",
            "same-inode",
            "same-owner",
            "same-group",
            "exit-code"
          ]
        },
        "description": {"type": "string", "minLength": 5},
        "expected": {},
        "normalize": {"enum": ["exact", "trim", "whitespace"]},
        "path": {"type": "string", "minLength": 1},
        "other_path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["any", "file", "directory"]}
      },
      "additionalProperties": false
    }
  }
}
